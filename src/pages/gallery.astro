---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { galleryImage } from "../lib/gallery";
import tagList from "../data/tags.json";

const art = (await getCollection("art")).sort((a, b) => +b.data.date - +a.data.date);
const years = Map.groupBy(art, (a) => a.data.date.getUTCFullYear());
const used = new Set(art.flatMap((a) => a.data.tags));
const tags = tagList.tags.filter((t) => used.has(t));
const images = new Map(await Promise.all(art.map(async (a) => [a.id, await galleryImage(a.data.image)] as const)));
---
<Base title="gallery">
<div class="tags">
<button aria-pressed="true" data-tag="">all</button>
{tags.map((t) => <button aria-pressed="false" data-tag={t}>{t}</button>)}
</div>
{[...years].map(([year, pieces]) => (
  <section>
  <h2 class="year">{year}</h2>
  <div class="grid">
  {pieces.map((a) => {
    const image = images.get(a.id)!;
    const size = Math.min(360, a.data.image.width, a.data.image.height);
    const widths = [...new Set([180, 360, 540].map((width) => Math.min(width, a.data.image.width, a.data.image.height)))];
    const eager = art.indexOf(a) < 4;
    return (
    <button data-tags={a.data.tags.join(" ")} data-full={image.src} data-srcset={image.srcset} data-sizes={image.sizes} data-width={image.width} data-height={image.height} data-cap={a.data.caption ?? a.data.title} data-alt={a.data.alt ?? ""} data-placeholder={image.placeholder}>
    <Image src={a.data.image} alt={a.data.alt ?? a.data.title} width={size} height={size} fit="cover" widths={widths} sizes={eager ? "(max-width: 900px) 240px, 180px" : "auto, (max-width: 900px) 240px, 180px"} loading={eager ? "eager" : "lazy"} />
    </button>
    );
  })}
  </div>
  </section>
))}
<dialog aria-labelledby="caption">
<figure aria-labelledby="caption">
<div class="artwork"></div>
<figcaption>
<form method="dialog"><button class="close">close</button></form>
<p id="caption"></p>
<details><summary>alt text</summary><p></p></details>
</figcaption>
</figure>
</dialog>
</Base>
<script>
document.addEventListener("astro:page-load", () => {
  const found = document.querySelector("dialog");
  if (!found) return;
  const box = found;
  const artwork = box.querySelector<HTMLElement>(".artwork")!;
  const [cap, alt] = box.querySelectorAll("figcaption p");
  const thumbs = document.querySelectorAll<HTMLButtonElement>(".grid button");
  const images = new Map<HTMLButtonElement, HTMLImageElement>();

  function full(button: HTMLButtonElement) {
    const cached = images.get(button);
    if (cached) return cached;
    const image = new window.Image(Number(button.dataset.width), Number(button.dataset.height));
    image.alt = button.querySelector("img")!.alt;
    image.sizes = button.dataset.sizes!;
    image.srcset = button.dataset.srcset!;
    image.src = button.dataset.full!;
    image.decode().then(() => (image.dataset.ready = ""), () => images.delete(button));
    images.set(button, image);
    return image;
  }

  function warm(button: HTMLButtonElement) {
    const connection = (navigator as Navigator & { connection?: { saveData: boolean; effectiveType: string } }).connection;
    if (!connection?.saveData && !connection?.effectiveType.includes("2g")) full(button);
  }

  thumbs.forEach((b) => {
    let timer: ReturnType<typeof setTimeout>;
    b.onpointerenter = (e) => {
      if (e.pointerType === "mouse") timer = setTimeout(() => warm(b), 60);
    };
    b.onpointerleave = () => clearTimeout(timer);
    b.onpointerdown = () => full(b);
    b.onfocus = () => warm(b);
    b.onclick = () => {
      artwork.style.width = b.dataset.sizes!;
      artwork.style.aspectRatio = `${b.dataset.width} / ${b.dataset.height}`;
      artwork.style.setProperty("--placeholder", `url(${b.dataset.placeholder})`);
      artwork.replaceChildren(full(b));
      cap.textContent = b.dataset.cap!;
      alt.textContent = b.dataset.alt!;
      alt.parentElement!.hidden = !b.dataset.alt;
      box.showModal();
      box.scrollTop = 0;
    };
  });

  box.onclick = (e) => {
    if (e.target === box) box.close();
  };

  document.querySelectorAll<HTMLButtonElement>(".tags button").forEach((t, _, all) => {
    t.onclick = () => {
      all.forEach((x) => x.setAttribute("aria-pressed", String(x === t)));
      thumbs.forEach((b) => (b.hidden = !!t.dataset.tag && !b.dataset.tags!.split(" ").includes(t.dataset.tag)));
      document.querySelectorAll("section").forEach((s) => (s.hidden = !s.querySelector("button:not([hidden])")));
    };
  });
});
</script>
