---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { excerpt } from "../../lib/excerpt";

export async function getStaticPaths() {
  return (await getCollection("posts")).map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={excerpt(post.body)} type="article" published={post.data.date}>
<h2>{post.data.title}</h2>
<small>{post.data.date.toLocaleDateString("en-US", { timeZone: "UTC" })}</small>
<Content />
<p><a href="/blog">back</a></p>
</Base>
