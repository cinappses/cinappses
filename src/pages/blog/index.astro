---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("posts")).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="blog">
<h2>blog</h2>
<ul class="posts">
{posts.map((p) => <li><a href={`/blog/${p.id}/`}>{p.data.title}</a> <small>{p.data.date.toLocaleDateString("en-US", { timeZone: "UTC" })}</small></li>)}
</ul>
</Base>
