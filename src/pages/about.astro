---
import { Image } from "astro:assets";
import { getCollection, getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";

const { Content } = await render((await getEntry("pages", "about"))!);
const applings = await getCollection("applings");
---
<Base title="about">
<Content />
<h2>friends</h2>
<div class="pen">
{applings.map((c) => (
  <a href={c.data.link} data-name={c.data.name} draggable="false">
  <Image src={c.data.image} alt={c.data.name} width={56} draggable="false" />
  </a>
))}
<span class="pen-name" hidden></span>
</div>
<p class="recent" hidden>recently selected: <img alt="" width="24" height="24"> <b></b>, <a></a></p>
</Base>
<script>
const SIZE = 56;
const R = SIZE / 2;
const FRICTION = 0.97;
const BOUNCE = 0.6;
const MAX_SPEED = 40;
const DRAG_START = 6;
const FRAME = 1000 / 60;
const THROW = 1.4;
const STALE = 300;
const WINDOW = 120;

type Ball = { el: HTMLElement; x: number; y: number; vx: number; vy: number; face: number };

const pen = document.querySelector<HTMLElement>(".pen")!;
const tag = pen.querySelector<HTMLElement>(".pen-name")!;
const recent = document.querySelector<HTMLElement>(".recent")!;
const cols = Math.floor(pen.clientWidth / (SIZE + 12));
pen.style.minHeight = `${Math.ceil(pen.querySelectorAll("a").length / cols) * (SIZE + 12) + 80}px`;
const balls: Ball[] = [...pen.querySelectorAll<HTMLElement>("a")].map((el, i) => ({
  el,
  x: R + 6 + (i % cols) * (SIZE + 12) + Math.random() * 8,
  y: R + 6 + Math.floor(i / cols) * (SIZE + 12) + Math.random() * 8,
  vx: 0,
  vy: 0,
  face: Math.random() < 0.5 ? -1 : 1,
}));
let held: Ball | null = null;
let hover: Ball | null = null;
let dragging = false;
let pointer = { x: 0, y: 0, t: 0 };
let moves: { x: number; y: number; t: number }[] = [];
let named: Ball | null = null;
let touch = false;
let press = { x: 0, y: 0 };
let offset = { x: 0, y: 0 };
let running = false;

const clamp = (v: number, lo: number, hi: number) => Math.min(Math.max(v, lo), hi);

function walls(b: Ball) {
  const w = pen.clientWidth - R;
  const h = pen.clientHeight - R;
  if (b.x < R || b.x > w) { b.vx *= -BOUNCE; b.x = clamp(b.x, R, w); }
  if (b.y < R || b.y > h) { b.vy *= -BOUNCE; b.y = clamp(b.y, R, h); }
}

function collide(a: Ball, b: Ball) {
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  const d = Math.hypot(dx, dy) || 1;
  if (d >= SIZE) return;
  const nx = dx / d;
  const ny = dy / d;
  const [ma, mb] = a === held ? [0, 1] : b === held ? [1, 0] : [0.5, 0.5];
  a.x -= nx * (SIZE - d) * ma; a.y -= ny * (SIZE - d) * ma;
  b.x += nx * (SIZE - d) * mb; b.y += ny * (SIZE - d) * mb;
  const p = ((a.vx - b.vx) * nx + (a.vy - b.vy) * ny) * (1 + BOUNCE);
  if (p <= 0) return;
  a.vx -= p * nx * ma; a.vy -= p * ny * ma;
  b.vx += p * nx * mb; b.vy += p * ny * mb;
}

function follow(b: Ball) {
  if (!dragging) return;
  b.vx = pointer.x - offset.x - b.x;
  b.vy = pointer.y - offset.y - b.y;
  b.x += b.vx;
  b.y += b.vy;
}

function move(b: Ball) {
  if (b === held) follow(b);
  else { b.x += b.vx; b.y += b.vy; b.vx *= FRICTION; b.vy *= FRICTION; }
  if (Math.abs(b.vx) > 1) b.face = Math.sign(b.vx);
}

function draw(b: Ball) {
  b.el.style.transform = `translate(${b.x - R}px, ${b.y - R}px) scaleX(${b.face})`;
}

function label() {
  tag.hidden = !hover;
  if (!hover) return;
  tag.textContent = hover.el.dataset.name!;
  const half = tag.offsetWidth / 2;
  const below = hover.y - R - tag.offsetHeight < 4;
  tag.style.left = `${clamp(hover.x, half + 4, pen.clientWidth - half - 4)}px`;
  tag.style.top = below ? `${hover.y + R + tag.offsetHeight + 4}px` : `${hover.y - R - 4}px`;
}

function step() {
  balls.forEach(move);
  balls.forEach((a, i) => balls.slice(i + 1).forEach((b) => collide(a, b)));
  balls.forEach(walls);
  balls.forEach(draw);
  label();
  const energy = balls.reduce((n, b) => n + Math.abs(b.vx) + Math.abs(b.vy), 0);
  running = !!held || energy > 0.1;
  if (running) requestAnimationFrame(step);
}

function wake() {
  if (!running) { running = true; requestAnimationFrame(step); }
}

function sample(e: PointerEvent) {
  const r = pen.getBoundingClientRect();
  return { x: e.clientX - r.left, y: e.clientY - r.top, t: performance.now() };
}

function grab(b: Ball, e: PointerEvent) {
  touch = e.pointerType === "touch";
  held = b;
  dragging = false;
  pointer = sample(e);
  press = { x: pointer.x, y: pointer.y };
  offset = { x: pointer.x - b.x, y: pointer.y - b.y };
  moves = [];
  b.vx = b.vy = 0;
  b.el.setPointerCapture(e.pointerId);
  wake();
}

function drag(e: PointerEvent) {
  const s = sample(e);
  const dt = Math.max(s.t - pointer.t, 1) / FRAME;
  const v = { x: (s.x - pointer.x) / dt, y: (s.y - pointer.y) / dt, t: s.t };
  if (Math.hypot(v.x, v.y) > 0.5) moves = [...moves.filter((m) => s.t - m.t < WINDOW), v];
  pointer = s;
  if (!dragging) dragging = Math.hypot(s.x - press.x, s.y - press.y) > DRAG_START;
}

function pick(b: Ball) {
  const link = recent.querySelector("a")!;
  const href = b.el.getAttribute("href")!;
  recent.querySelector("img")!.src = b.el.querySelector("img")!.src;
  recent.querySelector("b")!.textContent = b.el.dataset.name!;
  link.href = href;
  link.textContent = href.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");
  recent.hidden = false;
}

function release(b: Ball) {
  if (dragging) pick(b);
  const last = moves[moves.length - 1];
  const live = dragging && !!last && performance.now() - last.t < STALE;
  const peak = moves.reduce((a, m) => (Math.hypot(m.x, m.y) > Math.hypot(a.x, a.y) ? m : a), { x: 0, y: 0, t: 0 });
  b.vx = live ? clamp(peak.x * THROW, -MAX_SPEED, MAX_SPEED) : 0;
  b.vy = live ? clamp(peak.y * THROW, -MAX_SPEED, MAX_SPEED) : 0;
  held = null;
  wake();
}

balls.forEach((b) => {
  b.el.onpointerdown = (e) => grab(b, e);
  b.el.onpointermove = (e) => { if (held === b) drag(e); };
  b.el.onpointerup = () => { if (held === b) release(b); };
  b.el.onpointerenter = () => { hover = b; label(); };
  b.el.onpointerleave = (e) => {
    if (e.pointerType === "touch" || hover !== b || held === b) return;
    hover = null;
    label();
  };
  b.el.onclick = (e) => {
    if (dragging || (touch && named !== b)) e.preventDefault();
    if (touch && !dragging) { named = hover = b; label(); }
  };
});

balls.forEach(draw);
</script>
