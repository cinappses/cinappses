---
import { Image } from "astro:assets";
import { getCollection, getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";

const { Content } = await render((await getEntry("pages", "about"))!);
const critters = await getCollection("critters");
---
<Base title="about">
<Content />
<h2>friends</h2>
<div class="pen">
{critters.map((c) => (
  <a href={c.data.link} title={c.data.name} draggable="false">
  <Image src={c.data.image} alt={c.data.name} width={56} draggable="false" />
  </a>
))}
</div>
</Base>
<script>
const SIZE = 56;
const R = SIZE / 2;
const FRICTION = 0.985;
const BOUNCE = 0.8;

type Ball = { el: HTMLElement; x: number; y: number; vx: number; vy: number };

const pen = document.querySelector<HTMLElement>(".pen")!;
const balls: Ball[] = [...pen.querySelectorAll<HTMLElement>("a")].map((el) => ({
  el,
  x: R + Math.random() * (pen.clientWidth - SIZE),
  y: R + Math.random() * (pen.clientHeight - SIZE),
  vx: 0,
  vy: 0,
}));
let held: Ball | null = null;
let moved = 0;
let running = false;

function walls(b: Ball) {
  const w = pen.clientWidth - R;
  const h = pen.clientHeight - R;
  if (b.x < R || b.x > w) { b.vx *= -BOUNCE; b.x = Math.min(Math.max(b.x, R), w); }
  if (b.y < R || b.y > h) { b.vy *= -BOUNCE; b.y = Math.min(Math.max(b.y, R), h); }
}

function collide(a: Ball, b: Ball) {
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  const d = Math.hypot(dx, dy) || 1;
  if (d >= SIZE) return;
  const nx = dx / d;
  const ny = dy / d;
  const push = (SIZE - d) / 2;
  a.x -= nx * push; a.y -= ny * push;
  b.x += nx * push; b.y += ny * push;
  const p = (a.vx - b.vx) * nx + (a.vy - b.vy) * ny;
  if (p <= 0) return;
  a.vx -= p * nx; a.vy -= p * ny;
  b.vx += p * nx; b.vy += p * ny;
}

function step() {
  let energy = 0;
  for (const b of balls) {
    if (b !== held) { b.x += b.vx; b.y += b.vy; b.vx *= FRICTION; b.vy *= FRICTION; }
    walls(b);
    energy += Math.abs(b.vx) + Math.abs(b.vy);
  }
  balls.forEach((a, i) => balls.slice(i + 1).forEach((b) => collide(a, b)));
  for (const b of balls) b.el.style.transform = `translate(${b.x - R}px, ${b.y - R}px)`;
  running = !!held || energy > 0.05;
  if (running) requestAnimationFrame(step);
}

function wake() {
  if (!running) { running = true; requestAnimationFrame(step); }
}

function local(e: PointerEvent) {
  const r = pen.getBoundingClientRect();
  return { x: e.clientX - r.left, y: e.clientY - r.top };
}

balls.forEach((b) => {
  b.el.onpointerdown = (e) => {
    held = b;
    moved = 0;
    b.vx = b.vy = 0;
    b.el.setPointerCapture(e.pointerId);
    wake();
  };
  b.el.onpointermove = (e) => {
    if (held !== b) return;
    const p = local(e);
    b.vx = p.x - b.x;
    b.vy = p.y - b.y;
    moved += Math.hypot(b.vx, b.vy);
    b.x = p.x;
    b.y = p.y;
  };
  b.el.onpointerup = () => { held = null; };
  b.el.onclick = (e) => { if (moved > 6) e.preventDefault(); };
});

wake();
</script>
