---
import { getCollection, render } from "astro:content";
import { ClientRouter } from "astro:transitions";
import "../styles/site.css";

const { title, description = "Hi, I’m Luci! I’m a mixed g’wichin comic artist and illustrator. I love to draw people eating food and being friends!", noindex = false } = Astro.props;
const name = title ? `${title} | cinappses` : "cinappses";
const url = new URL(Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/"), Astro.site);
const [latest] = (await getCollection("status")).sort((a, b) => +b.data.date - +a.data.date);
const { Content: Status } = await render(latest);
---
<!doctype html>
<html lang="en" transition:animate="none">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" type="image/png" href="/favicon.png">
<link rel="preload" as="image" href="/logo.webp" type="image/webp">
<link rel="stylesheet" href="/photos.css">
<link rel="stylesheet" href="/prose.css">
<ClientRouter />
<title>{name}</title>
<meta name="description" content={description}>
{noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={url}>}
<meta name="theme-color" content="#f1a164">
<meta property="og:site_name" content="cinappses">
<meta property="og:type" content="website">
<meta property="og:title" content={name}>
<meta property="og:description" content={description}>
<meta property="og:url" content={url}>
<link rel="sitemap" href="/sitemap-index.xml">
</head>
<body>
<a class="skip" href="#content">skip to content</a>
<header transition:persist><h1><a href="/"><picture><source srcset="/logo.webp" type="image/webp"><img src="/logo.jpg" alt="cinappses" width="1600" height="781"></picture></a></h1></header>
<div class="site">
<aside class="doll" transition:persist>
<div class="status">
<a href="/status">{latest.data.date.toLocaleDateString("en-US", { timeZone: "UTC" })}</a>
<Status />
</div>
<img src="/doll.webp" alt="" width="263" height="373" />
<script>
document.querySelector(".doll > img")?.addEventListener("contextmenu", (e) => {
  (e.currentTarget as HTMLImageElement).src = "/doll.gif";
}, { once: true });
</script>
</aside>
<main id="content" tabindex="0" transition:animate="none"><slot /></main>
<nav transition:persist>
<ul>
<li><a href="/">Home</a></li>
<li><a href="/about">About</a></li>
<li><a href="/guestbook">Guestbook</a></li>
</ul>
<ul>
<li><a href="/gallery">Gallery</a></li>
<li><a href="/scans">Scans</a></li>
<li><a href="/blog">Blog</a></li>
<li><a href="/comic">Comic</a></li>
</ul>
<div class="contact">
<p>inquiries at <a href="mailto:cinappses@gmail.com">cinappses@gmail.com</a></p>
<div class="socials">
<a href="https://bsky.app/profile/cinappses.org" aria-label="bluesky"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 0 1-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z"/></svg></a>
<a href="https://cinappses.tumblr.com" aria-label="tumblr"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.563 24c-5.093 0-7.031-3.756-7.031-6.411V9.747H5.116V6.648c3.63-1.313 4.512-4.596 4.71-6.469C9.84.051 9.941 0 9.999 0h3.517v6.114h4.801v3.633h-4.82v7.47c.016 1.001.375 2.371 2.207 2.371h.09c.631-.02 1.486-.205 1.936-.419l1.156 3.425c-.436.636-2.4 1.374-4.156 1.404h-.178l.011.002z"/></svg></a>
<a href="https://ko-fi.com/cinappses" aria-label="ko-fi"><svg viewBox="1 1.5 22 21" aria-hidden="true" fill-rule="evenodd"><path d="M2 5h15v6.5a6.5 6.5 0 0 1-6.5 6.5h-2A6.5 6.5 0 0 1 2 11.5zm15 2h2.5a3.5 3.5 0 0 1 0 7H17v-2h2.5a1.5 1.5 0 0 0 0-3H17zm-7.5 9s-5-2.9-5-6.2a2.5 2.5 0 0 1 5-.6 2.5 2.5 0 0 1 5 .6c0 3.3-5 6.2-5 6.2z"/></svg></a>
</div>
</div>
</nav>
</div>
<footer>&copy; cinappses {new Date().getFullYear()}</footer>
</body>
</html>
